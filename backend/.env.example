# Copy this file to .env and fill it in. Never commit .env
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocks
DB_USER=postgres
DB_PASS=your-postgres-password

# Any long random text. The server refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# Optional
PORT=4000
# Time zone used for the "busiest hour / weekday" charts (default UTC), e.g. Asia/Phnom_Penh
BUSINESS_TZ=UTC
